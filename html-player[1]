<!doctype html>
<html lang="en" dir="ltr" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HTML Player – AI4EduTech</title>
    <meta name="color-scheme" content="light dark">
    <!-- ExcelJS: real cell colors, borders, fonts (SheetJS free has no styling) -->
    <script src="https://unpkg.com/exceljs@4.3.0/dist/exceljs.min.js"></script>
    <!-- docx 7.8.2: real Word binary generation -->
    <script src="https://cdn.jsdelivr.net/npm/docx@7.8.2/build/index.min.js"></script>
    <!-- FileSaver for download -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
    <style>
        :root {
            --bg: #ffffff;
            --fg: #0f172a;
            --muted: #6b7280;
            --card: #ffffff;
            --border: #e5e7eb;
            --brand: #0d6efd;
            --success: #16a34a;
            --warn: #f59e0b;
            --error: #dc2626;
            --shadow: 0 2px 8px rgba(0, 0, 0, .08);
            --iframe-bg: #f3f4f6;
            --purple: #8b5cf6;
            --teal: #14b8a6;
        }

        [data-theme="dark"] {
            --bg: #0b0f19;
            --fg: #e5e7eb;
            --muted: #9ca3af;
            --card: #0f172a;
            --border: #1f2937;
            --shadow: 0 2px 10px rgba(0, 0, 0, .4);
            --iframe-bg: #030712;
            --purple: #a78bfa;
            --teal: #2dd4bf;
        }

        * { box-sizing: border-box }
        html, body { height: 100%; background: var(--bg); color: var(--fg); margin: 0; font: 16px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, Arial }
        .container { max-width: 980px; margin: 0 auto; padding: 0 1rem }
        .card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); overflow: hidden }
        .card-header, .card-footer { padding: .75rem 1rem; border-bottom: 1px solid var(--border) }
        .card-footer { border-top: 1px solid var(--border); border-bottom: none }
        .card-body { padding: 1rem }
        .btn { display: inline-flex; align-items: center; gap: .4rem; padding: .5rem .8rem; border-radius: 10px; border: 1px solid var(--border); background: #f8f9fa; cursor: pointer; font-weight: 500; transition: all .2s ease; color: var(--fg) }
        .btn:hover { transform: translateY(-1px); box-shadow: 0 2px 6px rgba(0,0,0,.12) }
        .btn:active { transform: translateY(0) }
        .btn:disabled { opacity: .6; cursor: not-allowed; transform: none }
        .btn-primary { background: #0d6efd; border-color: #0d6efd; color: #fff }
        .btn-primary:hover { background: #0b5ed7; border-color: #0b5ed7 }
        .btn-success { background: #16a34a; border-color: #16a34a; color: #fff }
        .btn-success:hover { background: #15803d; border-color: #15803d }
        .btn-warn { background: #f59e0b; border-color: #f59e0b; color: #000 }
        .btn-warn:hover { background: #d97706; border-color: #d97706 }
        .btn-ghost { background: transparent; color: var(--fg) }
        .btn-ghost:hover { background: var(--border) }
        .btn-sm { padding: .35rem .65rem; font-size: .9rem }
        .btn-red { background: #dc2626; border-color: #dc2626; color: #fff }
        .btn-red:hover { background: #b91c1c; border-color: #b91c1c }
        .btn-blue { background: #2563eb; border-color: #2563eb; color: #fff }
        .btn-blue:hover { background: #1d4ed8; border-color: #1d4ed8 }
        .btn-green { background: #16a34a; border-color: #16a34a; color: #fff }
        .btn-green:hover { background: #15803d; border-color: #15803d }
        .btn-orange { background: #ea580c; border-color: #ea580c; color: #fff }
        .btn-orange:hover { background: #c2410c; border-color: #c2410c }
        .btn-cyan { background: #0891b2; border-color: #0891b2; color: #fff }
        .btn-cyan:hover { background: #0e7490; border-color: #0e7490 }
        .btn-indigo { background: #6366f1; border-color: #6366f1; color: #fff }
        .btn-indigo:hover { background: #4f46e5; border-color: #4f46e5 }
        .btn-purple { background: var(--purple); border-color: var(--purple); color: #fff }
        .btn-purple:hover { background: #7c3aed; border-color: #7c3aed }
        .badge { display: inline-block; padding: .2rem .5rem; background: #e9ecef; border-radius: 999px; font-size: .75rem; color: #111 }
        .badge-free { background: #10b981; color: #fff; font-weight: 600; padding: .3rem .6rem }
        .form-control { width: 100%; padding: .6rem .8rem; border: 1px solid var(--border); border-radius: 10px; background: var(--bg); color: var(--fg) }
        .form-control:focus { outline: 2px solid var(--brand); outline-offset: 2px }
        .form-control-sm { padding: .4rem .6rem; font-size: .92rem }
        .small { font-size: .875rem }
        .text-muted { color: var(--muted) }
        .d-flex { display: flex }
        .flex-wrap { flex-wrap: wrap }
        .gap-2 { gap: .5rem }
        .gap-3 { gap: .8rem }
        .align-center { align-items: center }
        .between { justify-content: space-between }
        .mb-2 { margin-bottom: .5rem }
        .mb-3 { margin-bottom: 1rem }
        .mb-4 { margin-bottom: 1.5rem }
        .mt-3 { margin-top: 1rem }
        .py-3 { padding: .75rem 0 }
        .py-4 { padding: 1rem 0 }
        .pb-5 { padding-bottom: 2rem }
        .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace }
        header svg { fill: currentColor; opacity: .75 }
        .status-message { min-height: 1.25rem; font-weight: 500 }
        .status-message.info { color: #2563eb }
        .status-message.success { color: var(--success) }
        .status-message.error { color: var(--error) }
        .preview-wrap { width: 100%; height: 520px; background: transparent; border-radius: 0 0 16px 16px; overflow: hidden }
        .preview-wrap iframe { width: 100%; height: 100%; border: 0; display: block; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; background: transparent }
        .preview-wrap.has-content { background: var(--iframe-bg) }
        .preview-wrap.has-content iframe { background: var(--iframe-bg) }
        .dropdown { position: relative }
        .dropdown-menu { position: absolute; top: 110%; right: 0; min-width: 8rem; background: var(--card); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--shadow); display: none; padding: .25rem 0; z-index: 10 }
        .dropdown-menu.show { display: block }
        .dropdown-item { display: block; width: 100%; padding: .5rem .8rem; background: transparent; border: 0; text-align: left; color: inherit; cursor: pointer; transition: background .2s }
        .dropdown-item:hover { background: var(--border) }
        footer { opacity: .75 }
        #advisory { background: var(--border); padding: .75rem; border-radius: 8px; border-left: 3px solid var(--warn) }
        textarea.form-control { resize: vertical; min-height: 200px }
        .form-check-input { width: 18px; height: 18px; cursor: pointer; accent-color: var(--brand) }
        @keyframes spin { to { transform: rotate(1turn) } }
        .spinner { display: inline-block; width: .9em; height: .9em; border: .15em solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spin .8s linear infinite }

        /* Export mode indicator */
        .export-badge {
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            padding: .2rem .5rem;
            background: #dcfce7;
            color: #15803d;
            border-radius: 6px;
            font-size: .75rem;
            font-weight: 600;
        }
        [data-theme="dark"] .export-badge { background: #14532d; color: #86efac; }

        @media print {
            body { margin: 0; padding: 20px }
            header, footer, .no-print { display: none !important }
            .card { border: none; box-shadow: none; page-break-inside: avoid }
            iframe { display: none }
        }
    </style>
</head>

<body>
    <header class="container py-3 no-print">
        <div class="d-flex align-center between gap-3 flex-wrap">
            <div class="d-flex align-center gap-2">
                <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 5h16v2H4zm0 6h16v2H4zm0 6h10v2H4z" />
                </svg>
                <h1 class="h5 m-0" style="margin:0;font-size:1.6rem">HTML Player</h1>
                <span class="badge badge-free">FREE</span>
                <span class="export-badge">✦ v2 Smart Export</span>
            </div>
            <div class="d-flex align-center gap-2">
                <button id="btn-theme" class="btn btn-ghost btn-sm" type="button">Dark</button>
                <div class="dropdown">
                    <button id="btn-lang" class="btn btn-ghost btn-sm" type="button"><span id="lang-label">EN</span></button>
                    <div class="dropdown-menu" id="lang-menu" role="menu" aria-labelledby="btn-lang">
                        <button class="dropdown-item" data-lang="en">English</button>
                        <button class="dropdown-item" data-lang="ar">العربية</button>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="container pb-5">
        <section id="creator-view" class="card mb-4 no-print">
            <div class="card-body">
                <p class="text-muted small mb-3" id="intro">Paste your HTML, JSON, or Markdown content, then Start. Save &amp; Share to get a student link. <strong>100% Free - No credits required!</strong></p>

                <div class="d-flex flex-wrap gap-2 mb-3 align-center">
                    <button id="btn-paste" class="btn btn-primary" type="button">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
                        <span id="btn-paste-text">Paste</span>
                    </button>
                    <button id="btn-start" class="btn btn-success" type="button">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        <span id="btn-start-text">Start</span>
                    </button>
                    <button id="btn-save" class="btn btn-warn" type="button">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        <span id="btn-save-text">Save &amp; Share</span>
                    </button>
                    <button id="btn-clear" class="btn btn-ghost btn-sm" type="button">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                        <span id="btn-clear-text">Clear</span>
                    </button>
                </div>

                <div class="mb-3">
                    <label class="small text-muted mb-2" style="display:block" id="export-label">Export Formats:</label>
                    <div class="d-flex flex-wrap gap-2">
                        <button id="btn-html"  class="btn btn-cyan   btn-sm" type="button"><span id="btn-html-text">HTML</span></button>
                        <button id="btn-pdf"   class="btn btn-red    btn-sm" type="button"><span id="btn-pdf-text">PDF</span></button>
                        <button id="btn-doc"   class="btn btn-blue   btn-sm" type="button"><span id="btn-doc-text">DOC ✦</span></button>
                        <button id="btn-excel" class="btn btn-green  btn-sm" type="button"><span id="btn-excel-text">XLS ✦</span></button>
                        <button id="btn-jpg"   class="btn btn-orange btn-sm" type="button"><span id="btn-jpg-text">JPG</span></button>
                        <button id="btn-json"  class="btn btn-indigo btn-sm" type="button"><span id="btn-json-text">JSON</span></button>
                        <button id="btn-md"    class="btn btn-purple btn-sm" type="button"><span id="btn-md-text">MD</span></button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="small text-muted mb-2" style="display:block" id="upload-label">Upload Formats:</label>
                    <div class="d-flex flex-wrap gap-2">
                        <input type="file" id="json-upload" accept=".json" style="display:none">
                        <button id="btn-upload-json" class="btn btn-indigo btn-sm" type="button"><span id="btn-upload-json-text">Upload JSON</span></button>
                        <input type="file" id="md-upload" accept=".md,.markdown" style="display:none">
                        <button id="btn-upload-md" class="btn btn-purple btn-sm" type="button"><span id="btn-upload-md-text">Upload MD</span></button>
                    </div>
                </div>

                <div class="mb-3 d-flex gap-2 align-center">
                    <input id="share-link" class="form-control form-control-sm" type="text" readonly placeholder="Share link appears here after Save">
                    <button id="btn-copy" class="btn btn-ghost" type="button">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        Copy
                    </button>
                </div>

                <div class="mb-3">
                    <label class="d-flex align-center gap-2 small">
                        <input class="form-check-input" type="checkbox" id="relaxSandbox">
                        <span id="relax-label">Relax sandbox (same-origin)</span>
                    </label>
                </div>

                <textarea id="source" class="form-control mono" rows="10" placeholder="<!-- Paste your HTML, JSON, or Markdown here -->"></textarea>

                <div id="advisory" class="text-muted small mt-3" style="display:none"></div>
                <div class="status-message mt-3" id="status"></div>
            </div>
        </section>

        <section id="viewer" class="card" style="display:none">
            <div class="card-header d-flex align-center between no-print">
                <div>
                    <strong id="viewerTitle">Preview</strong>
                    <span class="small text-muted" id="viewerMeta"></span>
                </div>
                <div class="d-flex gap-2">
                    <button id="btn-restart" class="btn btn-sm btn-ghost" type="button">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                        <span id="btn-restart-text">Restart</span>
                    </button>
                    <a id="btn-open" class="btn btn-sm btn-ghost" href="#" target="_blank" rel="noopener noreferrer">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                        <span id="btn-open-text">Open in New Tab</span>
                    </a>
                </div>
            </div>
            <div class="preview-wrap" id="preview-wrap">
                <iframe id="player" title="HTML Player Sandbox"></iframe>
            </div>
            <div class="card-footer small text-muted no-print" id="sandboxNote">
                ⚠️ Sandboxed environment. Some scripts may not run (CORS, external resources).
            </div>
        </section>

        <footer class="mt-4 py-3 text-center small text-muted">
            <p id="footerText">© 2025 AI4EduTech — Free HTML Player for Educational Content</p>
        </footer>
    </main>

    <script>
    (function () {
        'use strict';
        const $ = (s) => document.querySelector(s);
        const LS = { theme: 'html_player_theme', lang: 'html_player_lang', last: 'html_player_last_html' };

        const i18n = {
            en: {
                intro: 'Paste your HTML, JSON, or Markdown content, then Start. Save & Share to get a student link. <strong>100% Free - No credits required!</strong>',
                paste: 'Paste', start: 'Start', clear: 'Clear', saveShare: 'Save & Share',
                downloadHtml: 'HTML', savePdf: 'PDF', saveJpg: 'JPG', saveDoc: 'DOC ✦',
                saveExcel: 'XLS ✦', saveJson: 'JSON', saveMd: 'MD',
                uploadJson: 'Upload JSON', uploadMd: 'Upload MD',
                relaxSandbox: 'Relax sandbox', viewerTitle: 'Preview',
                sandboxNote: 'Sandboxed environment. Some scripts may not run.',
                restart: 'Restart', openNew: 'Open in New Tab',
                footer: '2025 AI4EduTech - Free HTML Player',
                themeToDark: 'Dark', themeToLight: 'Light',
                error: 'Error:', copied: 'Copied to clipboard', saved: 'Saved! Share link ready.',
                emptyHtml: 'Empty content', downloading: 'Preparing download...',
                exportSuccess: 'Export complete!', jsonUploaded: 'JSON loaded successfully',
                mdUploaded: 'Markdown loaded successfully', invalidJson: 'Invalid JSON format',
                mdConverted: 'Markdown converted to HTML', clearConfirm: 'Clear editor and start fresh?'
            },
            ar: {
                intro: 'الصق HTML أو JSON أو Markdown، ثم ابدأ. احفظ وشارك للحصول على رابط. <strong>مجاني 100%!</strong>',
                paste: 'لصق', start: 'ابدأ', clear: 'مسح', saveShare: 'حفظ ومشاركة',
                downloadHtml: 'HTML', savePdf: 'PDF', saveJpg: 'JPG', saveDoc: 'DOC ✦',
                saveExcel: 'XLS ✦', saveJson: 'JSON', saveMd: 'MD',
                uploadJson: 'رفع JSON', uploadMd: 'رفع MD',
                relaxSandbox: 'تخفيف الصندوق', viewerTitle: 'معاينة',
                sandboxNote: 'بيئة محمية. قد لا تعمل بعض البرامج.',
                restart: 'إعادة التشغيل', openNew: 'فتح في تبويب جديد',
                footer: '2025 AI4EduTech - مشغل HTML مجاني',
                themeToDark: 'داكن', themeToLight: 'فاتح',
                error: 'خطأ:', copied: 'تم النسخ', saved: 'تم الحفظ!',
                emptyHtml: 'محتوى فارغ', downloading: 'جاري التحضير...',
                exportSuccess: 'اكتمل التصدير!', jsonUploaded: 'تم تحميل JSON',
                mdUploaded: 'تم تحميل Markdown', invalidJson: 'تنسيق JSON غير صالح',
                mdConverted: 'تم تحويل Markdown إلى HTML', clearConfirm: 'مسح المحرر والبدء من جديد؟'
            }
        };

        const btnTheme   = $('#btn-theme');
        const btnLang    = $('#btn-lang');
        const langMenu   = $('#lang-menu');
        const langLabel  = $('#lang-label');
        const btnPaste   = $('#btn-paste');
        const btnStart   = $('#btn-start');
        const btnSave    = $('#btn-save');
        const btnClear   = $('#btn-clear');
        const btnHtml    = $('#btn-html');
        const btnPdf     = $('#btn-pdf');
        const btnDoc     = $('#btn-doc');
        const btnExcel   = $('#btn-excel');
        const btnJpg     = $('#btn-jpg');
        const btnJson    = $('#btn-json');
        const btnMd      = $('#btn-md');
        const btnUploadJson = $('#btn-upload-json');
        const btnUploadMd   = $('#btn-upload-md');
        const jsonUpload = $('#json-upload');
        const mdUpload   = $('#md-upload');
        const btnCopy    = $('#btn-copy');
        const btnRestart = $('#btn-restart');
        const btnOpenNew = $('#btn-open');
        const sourceEl   = $('#source');
        const shareLink  = $('#share-link');
        const relaxSandbox = $('#relaxSandbox');
        const advisory   = $('#advisory');
        const status     = $('#status');
        const iframe     = $('#player');
        const previewWrap = $('#preview-wrap');

        let currentContentId = null;

        // ─── INIT ──────────────────────────────────────────────────────────────────
        (() => {
            const saved_theme = localStorage.getItem(LS.theme) || 'light';
            document.documentElement.setAttribute('data-theme', saved_theme);
            updateThemeButtonLabel();
            const saved_lang = localStorage.getItem(LS.lang) || 'en';
            setLang(saved_lang);
            const params = new URLSearchParams(window.location.search);
            const sharedId = params.get('id');
            if (sharedId) {
                $('#creator-view').style.display = 'none';
                currentContentId = sharedId;
                loadById(sharedId);
            } else {
                loadLastDraft();
            }
        })();

        // ─── THEME / LANG ──────────────────────────────────────────────────────────
        btnTheme.addEventListener('click', () => {
            const cur = document.documentElement.getAttribute('data-theme');
            const next = cur === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem(LS.theme, next);
            updateThemeButtonLabel();
        });
        btnLang.addEventListener('click', (e) => { e.stopPropagation(); langMenu.classList.toggle('show'); });
        document.addEventListener('click', () => langMenu.classList.remove('show'));
        langMenu.querySelectorAll('[data-lang]').forEach(btn => {
            btn.addEventListener('click', () => { setLang(btn.dataset.lang); langMenu.classList.remove('show'); });
        });

        // ─── CLEAR ─────────────────────────────────────────────────────────────────
        btnClear.addEventListener('click', () => {
            if (sourceEl.value.trim() && !confirm(t('clearConfirm'))) return;
            sourceEl.value = '';
            shareLink.value = '';
            currentContentId = null;
            clearDraft();
            advisory.style.display = 'none';
            $('#viewer').style.display = 'none';
            toast('info', 'Cleared.');
        });

        // ─── EXPORT BUTTONS ────────────────────────────────────────────────────────
        btnHtml.addEventListener('click',  () => { const c = sourceEl.value.trim(); if (!c) return toast('error', t('emptyHtml')); exportAsHTML(c); });
        btnPdf.addEventListener('click',   () => { const c = sourceEl.value.trim(); if (!c) return toast('error', t('emptyHtml')); exportAsPDF(c); });
        btnDoc.addEventListener('click',   async () => { const c = sourceEl.value.trim(); if (!c) return toast('error', t('emptyHtml')); await exportAsDOC(c); });
        btnExcel.addEventListener('click', async () => { const c = sourceEl.value.trim(); if (!c) return toast('error', t('emptyHtml')); await exportAsExcel(c); });
        btnJpg.addEventListener('click', async () => { const c = sourceEl.value.trim(); if (!c) return toast('error', t('emptyHtml')); await exportAsJPG(c); });
        btnJson.addEventListener('click',  () => { const c = sourceEl.value.trim(); if (!c) return toast('error', t('emptyHtml')); exportAsJSON(c); });
        btnMd.addEventListener('click',    () => { const c = sourceEl.value.trim(); if (!c) return toast('error', t('emptyHtml')); exportAsMD(c); });

        // ─── UPLOAD ────────────────────────────────────────────────────────────────
        btnUploadJson.addEventListener('click', () => jsonUpload.click());
        btnUploadMd.addEventListener('click',   () => mdUpload.click());

        jsonUpload.addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (!file) return;
            try {
                const text = await file.text();
                const json = JSON.parse(text);
                let htmlContent = null;
                if (json.title && json.vocab && Array.isArray(json.vocab) && json.vocab.length > 0) {
                    // vocab card builder (unchanged)
                    const title = json.title, vocab = json.vocab, totalCards = vocab.length;
                    const p = [];
                    p.push('<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">');
                    p.push('<title>' + title + '</title>');
