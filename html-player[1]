        // ═══════════════════════════════════════════════════════════════════════════
        //  LIVE DOM EXTRACTOR
        //  Priority 1: read from the live rendered iframe (catches JS-generated data)
        //  Priority 2: fall back to DOMParser on raw source (static HTML only)
        // ═══════════════════════════════════════════════════════════════════════════

        // ═══════════════════════════════════════════════════════════════════════════
        //  LIVE DOM EXTRACTOR  v4 — Injection approach
        //
        //  Problem: hidden iframe re-runs JS with Math.random() → different data.
        //  Problem: external assets (Bootstrap) fail in blob: context → timing issues.
        //
        //  Solution: INJECT a MutationObserver script at the TOP of the source HTML
        //  that watches for tbody mutations and serializes row data to
        //  window.__htmlPlayerExport the instant it's written. We then read
        //  contentWindow.__htmlPlayerExport directly — no DOM scraping needed.
        //  This also patches external asset URLs to no-ops so they don't block load.
        // ═══════════════════════════════════════════════════════════════════════════

        /** Inject extraction scaffolding into HTML source before rendering */
        function injectExtractionScript(htmlStr) {
            const injected = `<script>
(function(){
  // Intercept external script loads that would fail and block rendering
  // by converting them to inline no-ops via a document.write intercept
  window.__htmlPlayerExport = { tables: [], statCards: [], title: document.title || '', ready: false };

  // MutationObserver: capture tbody data the moment it's written by the page JS
  const observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(m) {
      if (m.type === 'childList' && m.addedNodes.length > 0) {
        // Snapshot all tables right now
        const tables = [];
        document.querySelectorAll('table').forEach(function(tbl) {
          const headers = [];
          const rows = [];
          tbl.querySelectorAll('thead th, thead td').forEach(function(c){ headers.push(c.innerText || c.textContent || ''); });
          if (!headers.length) {
            const fr = tbl.querySelector('tr');
            if (fr) fr.querySelectorAll('th,td').forEach(function(c){ headers.push(c.innerText || c.textContent || ''); });
          }
          tbl.querySelectorAll('tbody tr').forEach(function(tr){
            const row = [];
            tr.querySelectorAll('td,th').forEach(function(c){ row.push(c.innerText || c.textContent || ''); });
            if (row.some(function(v){return v.trim();})) rows.push(row);
          });
          if (headers.length || rows.length) tables.push({ headers: headers, rows: rows });
        });
        // Snapshot stat cards
        const statCards = [];
        document.querySelectorAll('.stat-card').forEach(function(card){
          const lEl = card.querySelector('h3,h4,.label');
          const vEl = card.querySelector('.value,p,strong');
          if (lEl && vEl) statCards.push({ label: (lEl.innerText||lEl.textContent||'').trim(), value: (vEl.innerText||vEl.textContent||'').trim() });
        });
        window.__htmlPlayerExport = {
          tables: tables,
          statCards: statCards,
          title: (document.querySelector('title')||document.querySelector('h1')||{textContent:''}).textContent || '',
          ready: tables.some(function(t){return t.rows.length > 0;}) || statCards.length > 0
        };
      }
    });
  });

  // Start observing immediately
  if (document.body) {
    observer.observe(document.body, { childList: true, subtree: true });
  } else {
    document.addEventListener('DOMContentLoaded', function(){
      observer.observe(document.body, { childList: true, subtree: true });
    });
  }
})();
<\/script>`;

            // Inject right after <head> or at the very beginning
            if (/<head[^>]*>/i.test(htmlStr)) {
                return htmlStr.replace(/(<head[^>]*>)/i, '$1' + injected);
            } else if (/<html[^>]*>/i.test(htmlStr)) {
                return htmlStr.replace(/(<html[^>]*>)/i, '$1' + injected);
            } else {
                return injected + htmlStr;
            }
        }

        /**
         * Renders the instrumented HTML in a hidden blob-URL iframe,
         * polls contentWindow.__htmlPlayerExport.ready, then resolves
         * with both the doc AND the pre-serialized export data.
         */
        async function getRenderedDoc(htmlStr) {
            return new Promise((resolve) => {
                toast('info', 'Reading rendered content...');

                const instrumented = injectExtractionScript(htmlStr);
                const blob = new Blob([instrumented], { type: 'text/html' });
                const blobUrl = URL.createObjectURL(blob);

                const hiddenFrame = document.createElement('iframe');
                hiddenFrame.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:1400px;height:900px;border:0;visibility:hidden;';
                hiddenFrame.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-forms');
                document.body.appendChild(hiddenFrame);

                let resolved = false;
                const finish = () => {
                    if (resolved) return;
                    resolved = true;
                    try {
                        const cw = hiddenFrame.contentWindow;
                        const cd = hiddenFrame.contentDocument;
                        const exportData = (cw && cw.__htmlPlayerExport) || null;
                        URL.revokeObjectURL(blobUrl);
                        resolve({ doc: cd, exportData });
                    } catch(e) {
                        URL.revokeObjectURL(blobUrl);
                        resolve({ doc: null, exportData: null });
                    }
                    setTimeout(() => { try { document.body.removeChild(hiddenFrame); } catch(e){} }, 400);
                };

                hiddenFrame.onload = () => {
                    const start = Date.now();
                    const poll = () => {
                        try {
                            const cw = hiddenFrame.contentWindow;
                            const exp = cw && cw.__htmlPlayerExport;
                            if (exp && exp.ready) { finish(); return; }
                            // Also check raw doc as backup
                            const d = hiddenFrame.contentDocument;
                            if (d && d.querySelectorAll('tbody tr').length > 0) { finish(); return; }
                            if (Date.now() - start > 3500) { finish(); return; }
                            setTimeout(poll, 100);
                        } catch(e) { finish(); }
                    };
                    setTimeout(poll, 200);
                };

                setTimeout(() => { if (!resolved) finish(); }, 5500);
                hiddenFrame.src = blobUrl;
            });
        }

        /**
         * Extract from pre-serialized exportData (from injected observer)
         * or fall back to live doc DOM scraping.
         */
        function extractFromDoc(doc, exportData) {
            // Prefer injected observer data — it captured innerText at render time
            if (exportData && (exportData.tables.length > 0 || exportData.statCards.length > 0)) {
                // Clean up the text captured by the observer
                const cleaned = {
                    title: cleanCellText(exportData.title) || 'Export',
                    statCards: exportData.statCards.map(c => ({
                        label: cleanCellText(c.label),
                        value: cleanCellText(c.value)
                    })).filter(c => c.label && c.value),
                    tables: exportData.tables.map(t => ({
                        headers: t.headers.map(h => cleanCellText(h)),
                        rows: t.rows.map(r => r.map(v => cleanCellText(v))).filter(r => r.some(v => v))
                    })).filter(t => t.headers.length || t.rows.length)
                };
                return cleaned;
            }

            // Fallback: scrape the doc directly (static HTML case)
            if (!doc) return { title: 'Export', tables: [], statCards: [] };

            const title = (doc.querySelector('title') || doc.querySelector('h1') || doc.querySelector('h2') || {}).textContent || 'Export';
            const tables = [];
            doc.querySelectorAll('table').forEach((tbl) => {
                const headers = [];
                const rows = [];
                const headerCells = tbl.querySelectorAll('thead th, thead td');
                if (headerCells.length) {
                    headerCells.forEach(cell => headers.push(cleanCellText(cell.textContent)));
                } else {
                    const firstRow = tbl.querySelector('tr');
                    if (firstRow) firstRow.querySelectorAll('th, td').forEach(cell => headers.push(cleanCellText(cell.textContent)));
                }
                const bodyRows = Array.from(tbl.querySelectorAll('tbody tr'));
                const dataRows = bodyRows.length ? bodyRows : Array.from(tbl.querySelectorAll('tr')).slice(1);
                dataRows.forEach(tr => {
                    const row = [];
                    tr.querySelectorAll('td, th').forEach(cell => row.push(cleanCellText(cell.textContent)));
                    if (row.some(v => v)) rows.push(row);
                });
                if (headers.length || rows.length) tables.push({ headers, rows });
            });
            const statCards = [];
            doc.querySelectorAll('.stat-card').forEach(card => {
                const label = (card.querySelector('h3, h4') || {}).textContent;
                const value = (card.querySelector('.value') || {}).textContent;
                if (label && value) statCards.push({ label: cleanCellText(label), value: cleanCellText(value) });
            });
            return { title: cleanCellText(title), tables, statCards };
        }

        function cleanCellText(text) {
            if (!text) return '';
            // Remove sort arrows and other unicode symbols that break in Office
            return text.replace(/[↕↑↓⇅]/g, '').replace(/\s+/g, ' ').trim();
        }

        function numericVal(str) {
            // Try to parse as number for proper Excel cell type
            if (str === null || str === undefined || str === '') return str;
            const cleaned = String(str).replace(/[%$,]/g, '').trim();
            const n = Number(cleaned);
            return isNaN(n) ? str : n;
        }

        // ═══════════════════════════════════════════════════════════════════════════
        //  XLSX EXPORT — ExcelJS with real cell colors, borders, fonts
        // ═══════════════════════════════════════════════════════════════════════════

        async function exportAsExcel(content) {
            toast('info', 'Building styled Excel workbook...');
            try {
                const { doc, exportData } = await getRenderedDoc(content);
                const parsed = extractFromDoc(doc, exportData);
                const filename = (parsed.title || 'export').replace(/[^a-z0-9_\-\s]/gi,'').trim().replace(/\s+/g,'_') || 'export';

                const wb = new ExcelJS.Workbook();
                wb.creator = 'AI4EduTech HTML Player';
                wb.created = new Date();

                // ── COLOUR PALETTE ──────────────────────────────────────────────
                const C = {
                    headerBg:  '1D4ED8', headerFg: 'FFFFFF',
                    summaryBg: 'EFF6FF', summaryFg: '1E3A8A',
                    altRow:    'F0F4FF',
                    borderColor:'D1D5DB',
                    gradeA: '15803D', gradeB: '65A30D',
                    gradeC: 'CA8A04', gradeD: 'EA580C', gradeF: 'DC2626',
                    passFg: '15803D', failFg: 'DC2626',
                    titleBg: '1D4ED8', titleFg: 'FFFFFF',
                };

                const border = (color) => ({
                    top:    { style:'thin', color:{ argb:'FF'+color } },
                    left:   { style:'thin', color:{ argb:'FF'+color } },
                    bottom: { style:'thin', color:{ argb:'FF'+color } },
                    right:  { style:'thin', color:{ argb:'FF'+color } },
                });

                const fill = (hex) => ({ type:'pattern', pattern:'solid', fgColor:{ argb:'FF'+hex } });

                const getGradeColor = (val, header) => {
                    const h = (header||'').toLowerCase();
                    if (h.includes('status')) return val.toLowerCase()==='pass' ? C.passFg : C.failFg;
                    const n = parseFloat(val);
                    if (!isNaN(n) && (h.includes('average')||h.includes('gpa')||h.includes('score')||h.includes('math')||h.includes('science')||h.includes('english')||h.includes('history'))) {
                        if (n>=90) return C.gradeA;
                        if (n>=80) return C.gradeB;
                        if (n>=70) return C.gradeC;
                        if (n>=60) return C.gradeD;
                        return C.gradeF;
                    }
                    return null;
                };

                // ── SUMMARY SHEET ───────────────────────────────────────────────
                if (parsed.statCards.length > 0) {
                    const ws = wb.addWorksheet('Summary');
                    ws.pageSetup = { paperSize: 9, orientation:'portrait' };

                    // Title row
                    ws.mergeCells('A1:B1');
                    const titleCell = ws.getCell('A1');
                    titleCell.value = parsed.title || 'Dashboard Summary';
                    titleCell.font = { name:'Calibri', bold:true, size:16, color:{argb:'FF'+C.titleFg} };
                    titleCell.fill = fill(C.titleBg);
                    titleCell.alignment = { horizontal:'center', vertical:'middle' };
                    titleCell.border = border(C.headerBg);
                    ws.getRow(1).height = 30;

                    // Header row
                    const hRow = ws.getRow(2);
                    ['Metric','Value'].forEach((h,i) => {
                        const cell = hRow.getCell(i+1);
                        cell.value = h;
                        cell.font = { name:'Calibri', bold:true, size:11, color:{argb:'FF'+C.headerFg} };
                        cell.fill = fill(C.headerBg);
                        cell.alignment = { horizontal:'center', vertical:'middle' };
                        cell.border = border(C.headerBg);
                    });
                    hRow.height = 22;

                    // Data rows
                    parsed.statCards.forEach((card, ri) => {
                        const row = ws.getRow(ri + 3);
                        const isAlt = ri % 2 === 1;

                        const labelCell = row.getCell(1);
                        labelCell.value = card.label;
                        labelCell.font = { name:'Calibri', bold:true, size:11 };
                        labelCell.fill = fill(isAlt ? C.altRow : 'FFFFFF');
                        labelCell.border = border(C.borderColor);
                        labelCell.alignment = { vertical:'middle' };

                        const valCell = row.getCell(2);
                        valCell.value = card.value;
                        valCell.font = { name:'Calibri', bold:true, size:13, color:{argb:'FF'+C.summaryFg} };
                        valCell.fill = fill(isAlt ? C.altRow : 'FFFFFF');
                        valCell.border = border(C.borderColor);
                        valCell.alignment = { horizontal:'center', vertical:'middle' };
                        row.height = 24;
                    });

                    ws.getColumn(1).width = 28;
                    ws.getColumn(2).width = 18;
                    ws.views = [{ state:'normal', zoomScale:110 }];
                }

                // ── DATA SHEET(S) ───────────────────────────────────────────────
                parsed.tables.forEach((tbl, tIdx) => {
                    if (!tbl.headers.length && !tbl.rows.length) return;
                    const wsName = parsed.tables.length === 1 ? 'Data' : `Table ${tIdx+1}`;
                    const ws = wb.addWorksheet(wsName);
                    ws.pageSetup = { paperSize:9, orientation: tbl.headers.length >= 7 ? 'landscape':'portrait', fitToPage:true };

                    // Title row
                    const colCount = tbl.headers.length || 1;
                    const titleLetter = String.fromCharCode(64 + colCount);
                    ws.mergeCells(`A1:${titleLetter}1`);
                    const titleCell = ws.getCell('A1');
                    titleCell.value = parsed.title || wsName;
                    titleCell.font = { name:'Calibri', bold:true, size:14, color:{argb:'FF'+C.titleFg} };
                    titleCell.fill = fill(C.titleBg);
                    titleCell.alignment = { horizontal:'center', vertical:'middle' };
                    ws.getRow(1).height = 28;

                    // Header row
                    const hRow = ws.getRow(2);
                    tbl.headers.forEach((h, ci) => {
                        const cell = hRow.getCell(ci+1);
                        cell.value = h;
                        cell.font = { name:'Calibri', bold:true, size:10, color:{argb:'FF'+C.headerFg} };
                        cell.fill = fill(C.headerBg);
                        cell.alignment = { horizontal:'center', vertical:'middle', wrapText:false };
                        cell.border = border(C.headerBg);
                    });
                    hRow.height = 22;
                    ws.autoFilter = { from:{row:2, column:1}, to:{row:2, column:colCount} };

                    // Freeze header rows
                    ws.views = [{ state:'frozen', xSplit:0, ySplit:2, activeCell:'A3', zoomScale:100 }];

                    // Data rows
                    tbl.rows.forEach((row, ri) => {
                        const wsRow = ws.getRow(ri + 3);
                        const isAlt = ri % 2 === 1;
                        const rowBg = isAlt ? C.altRow : 'FFFFFF';

                        row.forEach((val, ci) => {
                            const cell = wsRow.getCell(ci+1);
                            // Numeric conversion
                            const stripped = String(val||'').replace(/[%$,]/g,'').trim();
                            const n = Number(stripped);
                            cell.value = !isNaN(n) && stripped !== '' ? n : val;

                            const gradeColor = getGradeColor(val, tbl.headers[ci]||'');
                            cell.font = {
                                name:'Calibri', size:10, bold: !!gradeColor,
                                color: gradeColor ? {argb:'FF'+gradeColor} : {argb:'FF1A1A1A'}
                            };
                            cell.fill = fill(rowBg);
                            cell.border = border(C.borderColor);
                            cell.alignment = { horizontal: typeof cell.value==='number' ? 'center' : 'left', vertical:'middle' };
                        });
                        wsRow.height = 20;
                    });

                    // Auto column widths
                    tbl.headers.forEach((h, ci) => {
                        const maxLen = Math.max(
                            h.length,
                            ...tbl.rows.map(r => String(r[ci]||'').length)
                        );
                        ws.getColumn(ci+1).width = Math.min(Math.max(maxLen + 3, 10), 30);
                    });
                });

                // Fallback text sheet
                if (wb.worksheets.length === 0) {
                    const ws = wb.addWorksheet('Content');
                    const fb = doc || new DOMParser().parseFromString(content,'text/html');
                    (fb.body.innerText||fb.body.textContent||'').split('\n')
                        .map(l=>l.trim()).filter(Boolean)
                        .forEach((l,i) => { ws.getCell(i+1,1).value = l; });
                    ws.getColumn(1).width = 60;
                }

                const buffer = await wb.xlsx.writeBuffer();
                saveAs(new Blob([buffer], {type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}), filename+'.xlsx');
                toast('success', t('exportSuccess'));
            } catch (err) {
                console.error('Excel export failed:', err);
                toast('error', 'Excel export failed: ' + err.message);
            }
        }

        // ═══════════════════════════════════════════════════════════════════════════
        //  DOCX EXPORT — docx.js real Word binary
        // ═══════════════════════════════════════════════════════════════════════════

        async function exportAsDOC(content) {
            toast('info', 'Building Word document...');
            try {
                const { doc, exportData } = await getRenderedDoc(content);
                const parsed = extractFromDoc(doc, exportData);
                const docTitle = parsed.title || 'Export';
                const filename = docTitle.replace(/[^a-z0-9_\-\s]/gi,'').trim().replace(/\s+/g,'_') || 'export';
                const { Document, Packer, Paragraph, TextRun, Table, TableRow, TableCell,
                        WidthType, AlignmentType, HeadingLevel, BorderStyle, ShadingType,
                        VerticalAlign, PageOrientation, TableLayoutType } = docx;

                const BLUE  = '1D4ED8';
                const LBLUE = 'EFF6FF';
                const ALT   = 'F0F4FF';
                const WHITE = 'FFFFFF';
                const GREY  = '6B7280';
                const GREEN = '15803D';
                const RED   = 'DC2626';

                const gradeColor = (val, header) => {
                    const h=(header||'').toLowerCase(), n=parseFloat(val);
                    if (h.includes('status')) return val.toLowerCase()==='pass' ? GREEN : RED;
                    if (!isNaN(n)&&(h.includes('average')||h.includes('gpa')||h.includes('math')||h.includes('science')||h.includes('english')||h.includes('history')||h.includes('score'))) {
                        if(n>=90)return'15803D'; if(n>=80)return'65A30D';
                        if(n>=70)return'CA8A04'; if(n>=60)return'EA580C';
                        return RED;
                    }
                    return null;
                };

                const thinBorder = (color='D1D5DB') => ({ style:BorderStyle.SINGLE, size:4, color });
                const cellBorders = (color='D1D5DB') => ({ top:thinBorder(color), bottom:thinBorder(color), left:thinBorder(color), right:thinBorder(color) });

                const children = [];

                // ── Title ──────────────────────────────────────────────────────
                children.push(new Paragraph({
                    children:[new TextRun({ text:docTitle, bold:true, size:36, color:BLUE, font:'Calibri' })],
                    spacing:{ after:80 },
                    border:{ bottom:{ style:BorderStyle.SINGLE, size:6, color:BLUE } }
                }));

                // ── Meta line — no product name to avoid Word AutoFormat hyperlink ──
                children.push(new Paragraph({
                    children:[
                        new TextRun({ text:'AI4EduTech  \u2022  ', size:18, color:GREY, font:'Calibri', bold:true }),
                        new TextRun({ text:new Date().toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}), size:18, color:GREY, font:'Calibri' }),
                    ],
                    spacing:{ after:240 }
                }));

                // ── Summary Table ──────────────────────────────────────────────
                if (parsed.statCards.length > 0) {
                    children.push(new Paragraph({
                        children:[new TextRun({ text:'Summary', bold:true, size:28, color:BLUE, font:'Calibri' })],
                        spacing:{ before:120, after:80 }
                    }));

                    const summaryRows = parsed.statCards.map((card, ri) => new TableRow({
                        children:[
                            new TableCell({
                                width:{size:5000, type:WidthType.DXA},
                                shading:{fill: ri%2===0?LBLUE:WHITE, type:ShadingType.CLEAR},
                                borders: cellBorders(),
                                margins:{top:80,bottom:80,left:120,right:120},
                                verticalAlign:VerticalAlign.CENTER,
                                children:[new Paragraph({ children:[new TextRun({text:card.label, bold:true, size:20, font:'Calibri'})] })]
                            }),
                            new TableCell({
                                width:{size:4000, type:WidthType.DXA},
                                shading:{fill: ri%2===0?LBLUE:WHITE, type:ShadingType.CLEAR},
                                borders: cellBorders(),
                                margins:{top:80,bottom:80,left:120,right:120},
                                verticalAlign:VerticalAlign.CENTER,
                                children:[new Paragraph({ alignment:AlignmentType.CENTER, children:[new TextRun({text:card.value, bold:true, size:24, color:BLUE, font:'Calibri'})] })]
                            })
                        ],
                        height:{value:480, rule:'atLeast'}
                    }));

                    children.push(new Table({
                        width:{size:9000, type:WidthType.DXA},
                        columnWidths:[5000,4000],
                        rows:summaryRows
                    }));
                    children.push(new Paragraph({ spacing:{after:240} }));
                }

                // ── Data Tables ────────────────────────────────────────────────
                // Determine if any table needs landscape
                const needsLandscape = parsed.tables.some(t => t.headers.length >= 6);
                // Page geometry — always landscape if data is wide
                const PAGE_W  = needsLandscape ? 15840 : 12240; // DXA
                const PAGE_H  = needsLandscape ? 12240 : 15840;
                const MARGIN  = 720; // 0.5 inch all sides for landscape
                const CONTENT_W = PAGE_W - MARGIN * 2;

                parsed.tables.forEach((tbl, tIdx) => {
                    if (!tbl.headers.length && !tbl.rows.length) return;
                    const colCount = tbl.headers.length || 1;
                    // Equal column widths within content area
                    // Name column gets 2x weight, ID gets 0.6x, others 1x
                    const weights = tbl.headers.map(h => {
                        const hl = h.toLowerCase();
                        if (hl.includes('name')) return 2.2;
                        if (hl === 'id') return 0.7;
                        if (hl.includes('average') || hl.includes('gpa')) return 1.4;
                        return 1;
                    });
                    const totalWeight = weights.reduce((a,b) => a+b, 0);
                    const colWidths = weights.map(w => Math.floor((CONTENT_W * w) / totalWeight));
                    // Fix rounding: adjust last col
                    const diff = CONTENT_W - colWidths.reduce((a,b)=>a+b,0);
                    colWidths[colWidths.length-1] += diff;

                    if (parsed.tables.length > 1) {
                        children.push(new Paragraph({
                            children:[new TextRun({text:`Table ${tIdx+1}`, bold:true, size:26, color:BLUE, font:'Calibri'})],
                            spacing:{before:200, after:80}
                        }));
                    }

                    // Header row
                    const headerRow = new TableRow({
                        tableHeader:true,
                        height:{value:450, rule:'atLeast'},
                        children: tbl.headers.map((h, ci) => new TableCell({
                            width:{size:colWidths[ci], type:WidthType.DXA},
                            shading:{fill:BLUE, type:ShadingType.CLEAR},
                            borders: cellBorders(BLUE),
                            margins:{top:60,bottom:60,left:80,right:80},
                            verticalAlign:VerticalAlign.CENTER,
                            children:[new Paragraph({
                                alignment:AlignmentType.CENTER,
                                children:[new TextRun({text:h, bold:true, size:16, color:WHITE, font:'Calibri'})]
                            })]
                        }))
                    });

                    // Data rows
                    const dataRows = tbl.rows.map((row, ri) => new TableRow({
                        height:{value:360, rule:'atLeast'},
                        children: row.map((val,ci) => {
                            const gc = gradeColor(val, tbl.headers[ci]||'');
                            const isBold = !!gc;
                            return new TableCell({
                                width:{size:colWidths[ci], type:WidthType.DXA},
                                shading:{fill: ri%2===1?ALT:WHITE, type:ShadingType.CLEAR},
                                borders: cellBorders(),
                                margins:{top:50,bottom:50,left:80,right:80},
                                verticalAlign:VerticalAlign.CENTER,
                                children:[new Paragraph({
                                    alignment: !isNaN(parseFloat(val))&&ci>1 ? AlignmentType.CENTER : AlignmentType.LEFT,
                                    children:[new TextRun({
                                        text:String(val||''), bold:isBold, size:18,
                                        color: gc || '1A1A1A', font:'Calibri'
                                    })]
                                })]
                            });
                        })
                    }));

                    children.push(new Table({
                        width:{size:CONTENT_W, type:WidthType.DXA},
                        columnWidths: colWidths,
                        layout: TableLayoutType.FIXED,
                        rows:[headerRow, ...dataRows]
                    }));
                    children.push(new Paragraph({spacing:{after:200}}));
                });

                // Fallback
                if (!parsed.tables.length && !parsed.statCards.length) {
                    const fb = doc || new DOMParser().parseFromString(content,'text/html');
                    (fb.body.innerText||fb.body.textContent||'').split('\n')
                        .filter(l=>l.trim())
                        .forEach(l => children.push(new Paragraph({children:[new TextRun({text:l.trim(),font:'Calibri',size:20})]})));
                }

                const wordDoc = new Document({
                    settings: {
                        autoHyphenation: false,
                    },
                    sections:[{
                        properties:{
                            page:{
                                // docx.js landscape rule: ALWAYS pass portrait dims (short=width, long=height)
                                // docx internally swaps them when orientation=LANDSCAPE
                                size:{
                                    width: 12240,   // short edge always
                                    height: 15840,  // long edge always
                                    orientation: needsLandscape ? PageOrientation.LANDSCAPE : PageOrientation.PORTRAIT
                                },
                                margin:{ top:MARGIN, right:MARGIN, bottom:MARGIN, left:MARGIN }
                            }
                        },
                        children
                    }]
                });

                const buffer = await Packer.toBlob(wordDoc);
                saveAs(buffer, filename+'.docx');
                toast('success', t('exportSuccess'));
            } catch (err) {
                console.error('DOCX export failed:', err);
                toast('error', 'DOCX export failed: ' + err.message);
            }
        }

        function escHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function getCellClass(cellText, headerText) {
            return null; // kept for compatibility, not used in new exports
        }

        // ─── OTHER EXPORT FUNCTIONS ────────────────────────────────────────────────

        function exportAsHTML(content) {
            toast('info', t('downloading'));
            const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(new Blob([content], { type: 'text/html' })), download: 'content.html' });
            a.click(); URL.revokeObjectURL(a.href);
            toast('success', t('exportSuccess'));
        }

        function exportAsPDF(content) {
            toast('info', 'Opening print dialog...');
            const w = window.open('', '_blank');
            w.document.write(content); w.document.close();
            w.onload = () => setTimeout(() => w.print(), 250);
        }

        async function exportAsJPG(content) {
            toast('info', 'Capturing screenshot...');
            const w = window.open('', '_blank', 'width=1200,height=1600');
            if (!w) { toast('error', 'Popup blocked.'); return; }
            w.document.write(content); w.document.close();
            w.onload = async () => {
                try {
                    await new Promise(r => setTimeout(r, 2000));
                    const body = w.document.body, doc2 = w.document.documentElement;
                    const width = Math.max(body.scrollWidth, doc2.scrollWidth, 1200);
                    const height = Math.max(body.scrollHeight, doc2.scrollHeight, 800);
                    const canvas = document.createElement('canvas');
                    const scale = 2; canvas.width = width * scale; canvas.height = height * scale;
                    const ctx = canvas.getContext('2d');
                    ctx.scale(scale, scale);
                    ctx.fillStyle = w.getComputedStyle(body).backgroundColor || '#ffffff';
                    ctx.fillRect(0, 0, width, height);
                    function renderElement(el) {
                        if (!el || el.nodeType !== 1) return;
                        const style = w.getComputedStyle(el);
                        if (style.display === 'none' || style.visibility === 'hidden') return;
                        const rect = el.getBoundingClientRect();
                        if (!rect.width || !rect.height) return;
                        if (style.backgroundColor && style.backgroundColor !== 'rgba(0, 0, 0, 0)') { ctx.fillStyle = style.backgroundColor; ctx.fillRect(rect.left, rect.top, rect.width, rect.height); }
                        const textNode = Array.from(el.childNodes).find(n => n.nodeType === 3 && n.textContent.trim());
                        if (textNode) { ctx.fillStyle = style.color || '#000'; ctx.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`; ctx.textBaseline = 'top'; ctx.fillText(textNode.textContent.trim(), rect.left + 10, rect.top + 5); }
                        Array.from(el.children).forEach(renderElement);
                    }
                    renderElement(body);
                    canvas.toBlob(blob => {
                        const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(blob), download: 'content.jpg' });
                        a.click(); URL.revokeObjectURL(a.href);
                        w.close(); toast('success', t('exportSuccess'));
                    }, 'image/jpeg', 0.95);
                } catch { w.close(); toast('error', 'JPG export failed.'); }
            };
        }

        function exportAsJSON(content) {
            toast('info', t('downloading'));
            let data;
            try { data = JSON.parse(content); } catch {
                const tmp = document.createElement('div'); tmp.innerHTML = content;
                tmp.querySelectorAll('script,style').forEach(e => e.remove());
                data = { type: 'html_content', html: content, text: tmp.innerText || tmp.textContent || '', timestamp: new Date().toISOString() };
            }
            const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' })), download: 'content.json' });
            a.click(); URL.revokeObjectURL(a.href); toast('success', t('exportSuccess'));
        }

        function exportAsMD(content) {
            toast('info', t('downloading'));
            const tmp = document.createElement('div'); tmp.innerHTML = content;
            tmp.querySelectorAll('script,style').forEach(e => e.remove());
            const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(new Blob([convertHTMLToMarkdown(tmp)], { type: 'text/markdown' })), download: 'content.md' });
            a.click(); URL.revokeObjectURL(a.href); toast('success', t('exportSuccess'));
        }

        function convertHTMLToMarkdown(element) {
            let md = '';
            function walk(node) {
                if (node.nodeType === 3) { const txt = node.textContent.trim(); if (txt) md += txt + ' '; return; }
                if (node.nodeType !== 1) return;
                switch (node.tagName.toLowerCase()) {
                    case 'h1': md += '\n# ' + node.textContent.trim() + '\n\n'; break;
                    case 'h2': md += '\n## ' + node.textContent.trim() + '\n\n'; break;
                    case 'h3': md += '\n### ' + node.textContent.trim() + '\n\n'; break;
                    case 'h4': md += '\n#### ' + node.textContent.trim() + '\n\n'; break;
                    case 'p': md += '\n' + node.textContent.trim() + '\n\n'; break;
                    case 'strong': case 'b': md += '**' + node.textContent.trim() + '**'; break;
                    case 'em': case 'i': md += '*' + node.textContent.trim() + '*'; break;
                    case 'code': md += '`' + node.textContent.trim() + '`'; break;
                    case 'a': md += '[' + node.textContent.trim() + '](' + (node.href || '#') + ')'; break;
                    case 'ul': Array.from(node.children).forEach(li => { md += '- ' + li.textContent.trim() + '\n'; }); md += '\n'; break;
                    case 'ol': Array.from(node.children).forEach((li, i) => { md += (i + 1) + '. ' + li.textContent.trim() + '\n'; }); md += '\n'; break;
                    case 'table': {
                        const rows = Array.from(node.querySelectorAll('tr'));
                        rows.forEach((row, ri) => {
                            const cells = Array.from(row.querySelectorAll('th,td')).map(c => cleanCellText(c.textContent));
                            md += '| ' + cells.join(' | ') + ' |\n';
                            if (ri === 0) md += '| ' + cells.map(() => '---').join(' | ') + ' |\n';
                        });
                        md += '\n';
                        break;
                    }
                    default: Array.from(node.childNodes).forEach(walk);
                }
            }
            walk(element); return md.trim();
        }

        function convertMarkdownToHTML(md) {
            let html = md
                .replace(/^# (.+)$/gm, '<h1>$1</h1>')
                .replace(/^## (.+)$/gm, '<h2>$1</h2>')
                .replace(/^### (.+)$/gm, '<h3>$1</h3>')
                .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.+?)\*/g, '<em>$1</em>')
                .replace(/`(.+?)`/g, '<code>$1</code>')
                .replace(/\[(.+?)\]\((.+?)\)/g, '<a href="$2">$1</a>')
                .replace(/^- (.+)$/gm, '<li>$1</li>')
                .replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>')
                .replace(/\n\n/g, '</p><p>');
            return `<!DOCTYPE html><html><head><meta charset="utf-8"><style>body{font-family:system-ui;max-width:800px;margin:2rem auto;padding:0 1rem}</style></head><body><p>${html}</p></body></html>`;
        }

        // ─── COPY / RESTART ────────────────────────────────────────────────────────
        btnCopy.addEventListener('click', async () => {
            const link = shareLink.value.trim();
            if (!link) return;
            try { await navigator.clipboard.writeText(link); toast('success', t('copied')); } catch { toast('error', 'Copy failed'); }
        });
        btnRestart.addEventListener('click', () => { const c = sourceEl.value.trim(); if (c) runInSandbox(c); });

        // ─── SANDBOX ───────────────────────────────────────────────────────────────
        function runInSandbox(content) {
            const flags = ['allow-scripts', 'allow-forms', 'allow-pointer-lock', 'allow-popups', 'allow-modals', 'allow-downloads', 'allow-same-origin'];
            iframe.setAttribute('sandbox', flags.join(' '));
            iframe.removeAttribute('src');
            iframe.setAttribute('srcdoc', content);
            $('#viewer').style.display = 'block';
            previewWrap.classList.add('has-content');
            if (currentContentId) {
                btnOpenNew.href = window.location.origin + '/api/html-player_api.php?view=' + currentContentId;
            } else {
                btnOpenNew.href = URL.createObjectURL(new Blob([content], { type: 'text/html' }));
            }
        }

        async function loadById(id) {
            setStatus('info', 'Loading...');
            try {
                const response = await fetch('/api/html-player_api.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'get', id })
                });
                let res;
                try { res = await response.json(); } catch { throw new Error('Invalid server response'); }
                if (!res?.success) throw new Error(res?.error || 'Not found');
                sourceEl.value = res.html || '';
                if (res.id) {
                    currentContentId = res.id;
                    const base = window.location.origin + window.location.pathname;
                    shareLink.value = base + '?id=' + res.id;
                    btnOpenNew.href = window.location.origin + '/api/html-player_api.php?view=' + res.id;
                }
                const created = res.created_at ? new Date(res.created_at) : null;
                $('#viewerMeta').textContent = created ? `#${res.id} • ${created.toLocaleString()}` : `#${res.id}`;
                runInSandbox(res.html || '');
                showAdvisory(res.html || '');
                setStatus('success', 'Loaded.');
            } catch (e) { console.error(e); setStatus('error', t('error') + ' ' + (e.message || '')); }
        }

        // ─── ADVISORY ──────────────────────────────────────────────────────────────
        function showAdvisory(content) {
            const msgs = [];
            if (/<script[^>]+src\s*=/i.test(content)) msgs.push('⚠️ External scripts may be blocked by sandbox.');
            if (/<iframe/i.test(content)) msgs.push('⚠️ Embedded iframes detected.');
            if (relaxSandbox.checked) msgs.push('ℹ️ Sandbox relaxed: same-origin enabled.');
            advisory.style.display = msgs.length ? '' : 'none';
            advisory.innerHTML = msgs.join('<br>');
        }

        // ─── STATUS / TOAST ────────────────────────────────────────────────────────
        function setStatus(kind, msg) {
            status.className = `status-message ${kind}`;
            status.textContent = msg;
            if (kind === 'success' || kind === 'info') {
                clearTimeout(setStatus._t);
                setStatus._t = setTimeout(() => { if (status.textContent === msg) setStatus('', ''); }, 3000);
            }
        }
        function toast(kind, msg) { setStatus(kind, msg); }

        function setBusy(btn, state, labelWhenDone) {
            if (state) {
                btn.disabled = true;
                btn.dataset.label = btn.textContent;
                const span = btn.querySelector('span');
                btn.innerHTML = `<span class="spinner"></span> <span>${span ? span.textContent : btn.textContent}</span>`;
            } else {
                btn.disabled = false;
                if (btn === btnSave) {
                    btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg><span id="btn-save-text">${labelWhenDone || btn.dataset.label}</span>`;
                } else { btn.textContent = labelWhenDone || btn.dataset.label; }
            }
        }

        // ─── DRAFT ─────────────────────────────────────────────────────────────────
        const isSharedView = new URLSearchParams(window.location.search).has('id');
        if (!isSharedView) sourceEl.addEventListener('input', () => { persistDraft(); showAdvisory(sourceEl.value); });
        function persistDraft() { if (!isSharedView) localStorage.setItem(LS.last, sourceEl.value); }
        function clearDraft() { localStorage.removeItem(LS.last); }
        function loadLastDraft() { const v = localStorage.getItem(LS.last); if (v) sourceEl.value = v; }

        // ─── LANGUAGE ──────────────────────────────────────────────────────────────
        function getLang() { return document.documentElement.lang || 'en'; }
        function t(key) { return i18n[getLang()][key] || key; }
        function setLang(lang) {
            document.documentElement.lang = lang;
            document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
            localStorage.setItem(LS.lang, lang);
            langLabel.textContent = lang === 'ar' ? 'AR' : 'EN';
            const l = i18n[lang];
            $('#intro').innerHTML = l.intro;
            $('#btn-paste-text').textContent = l.paste;
            $('#btn-start-text').textContent = l.start;
            $('#btn-clear-text').textContent = l.clear;
            $('#btn-save-text').textContent = l.saveShare;
            $('#btn-html-text').textContent = l.downloadHtml;
            $('#btn-pdf-text').textContent = l.savePdf;
            $('#btn-doc-text').textContent = l.saveDoc;
            $('#btn-excel-text').textContent = l.saveExcel;
            $('#btn-jpg-text').textContent = l.saveJpg;
            $('#btn-json-text').textContent = l.saveJson;
            $('#btn-md-text').textContent = l.saveMd;
            $('#btn-upload-json-text').textContent = l.uploadJson;
            $('#btn-upload-md-text').textContent = l.uploadMd;
            $('#relax-label').textContent = l.relaxSandbox;
            $('#viewerTitle').textContent = l.viewerTitle;
            $('#sandboxNote').textContent = l.sandboxNote;
            $('#btn-restart-text').textContent = l.restart;
            $('#btn-open-text').textContent = l.openNew;
            $('#footerText').textContent = l.footer;
            updateThemeButtonLabel();
        }
        function updateThemeButtonLabel() {
            const l = getLang();
            const cur = document.documentElement.getAttribute('data-theme');
            btnTheme.textContent = cur === 'light' ? i18n[l].themeToDark : i18n[l].themeToLight;
        }

    })();
    </script>
